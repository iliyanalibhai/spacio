MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=spacio
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Must be true in any real (HTTPS) deployment. False for local http dev.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
SERVICE_FEE_RATE=0.20
BOX_PRICE_PER_MONTH=10
REFUNDABLE_DEPOSIT=50

# Stripe (test mode). Leave blank to run locally without payments: browsing,
# search, and booking-request creation still work; identity verification,
# Checkout, and Connect onboarding endpoints return 503 and the hold-expiry
# sweep does not start.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for POST /verification/webhook (Stripe Identity).
STRIPE_WEBHOOK_SECRET=
# Signing secret for POST /payments/webhook (Checkout + Connect). Stripe
# issues one secret per registered endpoint. Subscribe this endpoint to:
# checkout.session.completed, checkout.session.expired, account.updated
# (enable "Listen to Connect events"). Locally:
#   stripe listen --forward-to localhost:8000/payments/webhook
STRIPE_PAYMENTS_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173

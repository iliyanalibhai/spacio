# Copy to api/.env for local dev, or to /opt/spacio/api/.env.production on
# the deploy host (see deploy/DEPLOY.md). Never commit a real .env — this
# file only documents the variables Settings (app/core/config.py) reads.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=spacio

# --- Auth ---
# No default in code on purpose — startup fails fast if unset. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Must be true in any real (HTTPS) deployment so the session cookie is never
# sent over plain http. Keep false for local dev (localhost is plain http).
COOKIE_SECURE=false

# No default, "*" is rejected. Comma-separated list of exact origins allowed
# to make credentialed (cookie-bearing) requests.
CORS_ORIGINS=http://localhost:5173

# --- Pricing ---
SERVICE_FEE_RATE=0.20
BOX_PRICE_PER_MONTH=10.0
REFUNDABLE_DEPOSIT=50.0

# --- Stripe ---
# Leave all four blank to run with payments disabled (booking requests still
# work; checkout/payout endpoints 503).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENTS_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173

# --- Semantic matching ---
# Set false to skip loading the ~90MB sentence-transformers model (used by
# the test suite; real deployments should leave this true).
EMBEDDINGS_ENABLED=true

# --- Listing photo storage ---
# Leave S3_BUCKET blank to store uploads on local disk (dev/CI default).
# Set both to switch POST /listings/upload to S3 — see
# app/services/image_storage.py. The deploy host's IAM role/user needs
# s3:PutObject on this bucket.
S3_BUCKET=
AWS_REGION=us-east-1
